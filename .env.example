PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/autoreply
REDIS_URL=redis://localhost:6379
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_VERSION=1

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=choose-a-long-random-string
META_GRAPH_VERSION=v23.0

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Human-like jitter before replying (seconds). Set both to 0 to disable.
REPLY_DELAY_MIN_S=5
REPLY_DELAY_MAX_S=30
